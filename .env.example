# Dev
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production → salin dari .env.production:
# NEXT_PUBLIC_API_URL=https://siwa-api.bplus360.com/api

# Secret bersama dgn backend Laravel — signature link dokumen KK (public/kk/*).
# WAJIB sama nilainya dengan KK_LINK_SECRET di backend/.env (generate: openssl rand -hex 32)
# KK_LINK_SECRET=
